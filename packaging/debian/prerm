#!/bin/sh
# Run before the package's files are removed.
# Stop the service for currently-logged-in users and disable it globally.
set -e

UNIT=spotify-ad-muter.service

case "$1" in
    remove|upgrade|deconfigure)
        if command -v loginctl >/dev/null 2>&1 && command -v runuser >/dev/null 2>&1; then
            loginctl list-users --no-legend 2>/dev/null | awk '{print $1, $2}' | \
            while read -r uid user; do
                [ -n "$uid" ] && [ -n "$user" ] || continue
                runtime_dir="/run/user/$uid"
                [ -d "$runtime_dir" ] || continue
                runuser -u "$user" -- env XDG_RUNTIME_DIR="$runtime_dir" \
                    systemctl --user disable --now "$UNIT" >/dev/null 2>&1 || true
            done
        fi
        if command -v systemctl >/dev/null 2>&1; then
            systemctl --global disable "$UNIT" >/dev/null 2>&1 || true
        fi
        ;;
esac

exit 0
